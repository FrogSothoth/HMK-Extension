					<top parent="leftanchor" />
					<left anchor="right" offset="41" />
				</anchored>
				<script>
					local ICON_DATA = {
						["Skull"]     = { shk = "shk5", bld = "bld1" },
						["Face"]      = { shk = "shk4", bld = "bld2" },
						["Neck"]      = { shk = "shk5", bld = "bld3", amp = "amp1" },
						["Shoulder"]  = { shk = "shk3", bld = "bld2" },
						["Upper Arm"] = { shk = "shk1", bld = "bld1", amp = "amp2" },
						["Elbow"]     = { shk = "shk2", bld = "bld1", amp = "amp2" },
						["Forearm"]   = { shk = "shk1", bld = "bld1", amp = "amp2" },
						["Hand"]      = { shk = "shk2", amp = "amp3" },
						["Thorax"]    = { shk = "shk4", bld = "bld2" },
						["Abdomen"]   = { shk = "shk4", bld = "bld3" },
						["Pelvis"]    = { shk = "shk4", bld = "bld2" },
						["Thigh"]     = { shk = "shk3", bld = "bld2", amp = "amp1" },
						["Knee"]      = { shk = "shk2", bld = "bld1", amp = "amp2" },
						["Calf"]      = { shk = "shk1", bld = "bld1", amp = "amp2" },
						["Foot"]      = { shk = "shk2", amp = "amp2" },
					};

					function onInit()
						local sLoc = DB.getValue(window.getDatabaseNode(), "location", "");
						local tData = ICON_DATA[sLoc];
						if not tData then return; end

						-- SHK always centered in this control
						addBitmapWidget(tData.shk);

						-- BLD in left control
						if tData.bld then
							window.icon_bld.addBitmapWidget(tData.bld);
						end

						-- AMP in right control
						if tData.amp then
							window.icon_amp.addBitmapWidget(tData.amp);
						end
					end
				</script>
			</genericcontrol>
			<genericcontrol name="icon_amp">
