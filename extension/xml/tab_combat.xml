	<!-- Template for active injury entry -->
	<windowclass name="harn_injury_entry">
		<margins control="0,0,0,2" />
		<script>
			local _nLastApplied = 0;

			function onInit()
				_nLastApplied = tonumber(level.getValue()) or 0;
				updateHeal();
			end

			function applyImpairment()
				local nLevel = tonumber(level.getValue()) or 0;
				local nDelta = nLevel - _nLastApplied;

				if nDelta ~= 0 and HarnManager and HarnManager.addImpairment then
					local nodeEntry = getDatabaseNode();
					if nodeEntry then
						local sLocation = location.getValue();
						local sSide = side.getValue();
						local nodeChar = nodeEntry.getParent().getParent();

						if nodeChar and sLocation ~= "" then
							local nValueToAdd = nDelta * 5;
							Debug.chat("Injury update: " .. sLocation .. " (Level " .. nLevel .. "), adding " .. nValueToAdd .. " to zone.");
							HarnManager.addImpairment(nodeChar, sLocation, sSide, nValueToAdd);
							_nLastApplied = nLevel;
						end
					end
				end
			end

			function updateHeal()
				local nodeEntry = getDatabaseNode();
				if not nodeEntry then return end

				local nInjuryHR = DB.getValue(nodeEntry, "injury_hr", 0);
				local nodeChar = nodeEntry.getParent().getParent();
				local nHB = 0;
				if nodeChar then
					nHB = DB.getValue(nodeChar, "healing_base", 0);
				end

				local nHeal = nInjuryHR * nHB;
				heal.setValue(nHeal);
			end
		</script>
		<sheetdata>
			<genericcontrol name="leftanchor">
				<anchored position="insidetopleft" offset="0,2" width="0" height="0" />
				<disabled />
			</genericcontrol>
			<!-- Location (text: Skull, Face, etc.) -->
			<stringfield name="location">
				<anchored to="leftanchor" width="65" height="20">
					<top />
					<left offset="2" />
				</anchored>
				<frame name="fielddark" offset="7,5,7,5" />
				<script>
					function onLoseFocus()
						window.applyImpairment();
					end
				</script>
			</stringfield>
			<!-- Side (L/R/-) -->
			<stringfield name="side">
				<anchored to="location" width="22" height="20">
					<top parent="leftanchor" />
					<left anchor="right" offset="2" />
				</anchored>
				<frame name="fielddark" offset="7,5,7,5" />
				<script>
					function onLoseFocus()
						window.applyImpairment();
					end
				</script>
			</stringfield>
			<!-- Severity (M/S/G) -->
			<stringfield name="severity">
				<anchored to="side" width="22" height="20">
					<top parent="leftanchor" />
					<left anchor="right" offset="2" />
				</anchored>
				<frame name="fielddark" offset="7,5,7,5" />
			</stringfield>
			<!-- Level (1-5) -->
			<stringfield name="level">
				<anchored to="severity" width="22" height="20">
					<top parent="leftanchor" />
					<left anchor="right" offset="2" />
				</anchored>
				<frame name="fielddark" offset="7,5,7,5" />
				<script>
					function onLoseFocus()
						window.applyImpairment();
					end
				</script>
			</stringfield>
			<!-- Aspect (B/E/P/F) -->
			<stringfield name="aspect">
				<anchored to="level" width="22" height="20">
					<top parent="leftanchor" />
					<left anchor="right" offset="2" />
				</anchored>
				<frame name="fielddark" offset="7,5,7,5" />
			</stringfield>
			<!-- BLD checkbox -->
			<buttoncontrol name="bleeding">
				<anchored to="aspect" width="15" height="15">
					<top parent="leftanchor" offset="2" />
					<left anchor="right" offset="4" />
				</anchored>
				<state icon="button_checkoff" />
				<state icon="button_checkon" />
			</buttoncontrol>
			<!-- INF checkbox -->
			<buttoncontrol name="infected">
				<anchored to="bleeding" width="15" height="15">
					<top parent="leftanchor" offset="2" />
					<left anchor="right" offset="4" />
				</anchored>
				<state icon="button_checkoff" />
				<state icon="button_checkon" />
			</buttoncontrol>
			<!-- HR (1-6) -->
			<numberfield name="injury_hr">
				<anchored to="infected" width="22" height="20">
					<top parent="leftanchor" />
					<left anchor="right" offset="2" />
				</anchored>
				<frame name="fielddark" offset="7,5,7,5" />
				<min>1</min>
				<max>6</max>
				<script>
					function onValueChanged()
						window.updateHeal();
					end
				</script>
			</numberfield>
			<!-- Heal (HR x HB) - readonly display -->
			<numberfield name="heal">
				<anchored to="injury_hr" width="28" height="20">
					<top parent="leftanchor" />
					<left anchor="right" offset="2" />
				</anchored>
				<frame name="fielddark" offset="7,5,7,5" />
				<readonly />
			</numberfield>
			<!-- Delete button -->
			<buttoncontrol name="idelete">
				<anchored to="heal" width="15" height="15">
					<top parent="leftanchor" offset="2" />
					<left anchor="right" offset="4" />
				</anchored>
				<icon>delete_injury</icon>
				<script>
					function onButtonPress()
						local node = window.getDatabaseNode();
						if node then
							local nLevel = tonumber(window.level.getValue()) or 0;
							if nLevel > 0 and HarnManager and HarnManager.addImpairment then
								local sLocation = DB.getValue(node, "location", "");
								local sSide = DB.getValue(node, "side", "-");
								local nodeChar = node.getParent().getParent();
								if nodeChar and sLocation ~= "" then
									HarnManager.addImpairment(nodeChar, sLocation, sSide, -nLevel * 5);
								end
							end
							node.delete();
						end
					end
				</script>
			</buttoncontrol>
		</sheetdata>
	</windowclass>

	<!-- Template for psyche stress entry -->
	<windowclass name="harn_psyche_entry">
		<margins control="0,0,0,2" />
		<script>
			local _nLastApplied = 0;

			function onInit()
				_nLastApplied = tonumber(level.getValue()) or 0;
				updateDeleteButton();
			end

			function updateDeleteButton()
				local bPerm = is_perm.getValue() == 1;
				idelete.setVisible(not bPerm);
			end

			function applyFatigueDelta()
				local nLevel = tonumber(level.getValue()) or 0;
				local nDelta = (nLevel - _nLastApplied) * 5;
				
				if nDelta ~= 0 and HarnManager and HarnManager.addWeaknessFatigue then
					local nodeChar = getDatabaseNode().getParent().getParent();
					if nodeChar then
						HarnManager.addWeaknessFatigue(nodeChar, nDelta);
						_nLastApplied = nLevel;
					end
				end
			end
		</script>
		<sheetdata>
			<genericcontrol name="leftanchor">
				<anchored position="insidetopleft" offset="0,2" width="0" height="0" />
				<disabled />
			</genericcontrol>
			<stringfield name="trait">
				<anchored to="leftanchor" width="75" height="20">
					<top />
					<left offset="2" />
				</anchored>
				<frame name="fielddark" offset="7,5,7,5" />
				<maxchars>20</maxchars>
			</stringfield>
			<!-- Using stringcycler to avoid dropdown bugs in lists -->
			<button_stringcycler name="intensity">
				<anchored to="trait" width="60" height="20">
					<top parent="leftanchor" />
					<left anchor="right" offset="4" />
				</anchored>
				<frame name="fielddark" offset="7,5,7,5" />
				<parameters>
					<labelsres>harn_trait|harn_impulse|harn_disorder</labelsres>
					<values>Trait|Impulse|Disorder</values>
					<default>Trait</default>
				</parameters>
			</button_stringcycler>
			<numberfield name="level">
				<anchored to="intensity" width="20" height="20">
					<top parent="leftanchor" />
					<left anchor="right" offset="4" />
				</anchored>
				<frame name="fielddark" offset="7,5,7,5" />
				<center />
				<min>0</min>
				<max>6</max>
				<script>
					function onValueChanged()
						local nVal = getValue();
						if nVal &lt; 0 then
							setValue(0);
							return;
						elseif nVal &gt; 6 then
							setValue(6);
							return;
						end
						window.applyFatigueDelta();
					end
				</script>
			</numberfield>
			<buttoncontrol name="is_perm">
				<anchored to="level" width="15" height="15">
					<top parent="leftanchor" offset="2" />
					<left anchor="right" offset="4" />
				</anchored>
				<state icon="button_checkoff" tooltip="Permanent (Lock)" />
				<state icon="button_checkon" tooltip="Permanent (Lock)" />
				<script>
					function onValueChanged()
						window.updateDeleteButton();
					end
				</script>
			</buttoncontrol>
			<buttoncontrol name="idelete">
				<anchored to="is_perm" width="15" height="15">
					<top parent="leftanchor" offset="2" />
					<left anchor="right" offset="3" />
				</anchored>
				<icon>delete_injury</icon>
				<script>
					function onButtonPress()
						local nLevel = tonumber(window.level.getValue()) or 0;
						if nLevel > 0 and HarnManager and HarnManager.addWeaknessFatigue then
							local nodeChar = window.getDatabaseNode().getParent().getParent();
							if nodeChar then
								HarnManager.addWeaknessFatigue(nodeChar, -nLevel * 5);
							end
						end
						window.getDatabaseNode().delete();
					end
				</script>
			</buttoncontrol>
		</sheetdata>
	</windowclass>

	<!-- Main combat tab -->
	<windowclass name="harn_tab_combat">
		<script>
			function onInit()
				-- Initialize body locations
				local nodeChar = getDatabaseNode();
				if not nodeChar then return; end

				local nodeList = DB.createChild(nodeChar, "bodylocations");

				-- Consolidation Logic: If Hip or Groin exist, rename/merge them to Pelvis
				local nodePelvis = nil;
				local nodesToMerge = {};
				for _, node in pairs(nodeList.getChildren()) do
					local sLoc = DB.getValue(node, "location", ""):lower();
					if sLoc == "pelvis" then
						nodePelvis = node;
					elseif sLoc == "hip" or sLoc == "groin" then
						table.insert(nodesToMerge, node);
					end
				end

				if #nodesToMerge > 0 then
					if not nodePelvis then
						nodePelvis = nodesToMerge[1];
						DB.setValue(nodePelvis, "location", "string", "Pelvis");
						table.remove(nodesToMerge, 1);
					end
					-- Delete extras
					for _, node in ipairs(nodesToMerge) do
						node.delete();
					end
				end

				-- Standard Initialization
				if DB.getChildCount(nodeList) == 0 then
					local locations = {
						"Skull", "Face", "Neck", "Shoulder", "Upper Arm",
						"Elbow", "Forearm", "Hand", "Thorax", "Abdomen",
						"Pelvis", "Thigh", "Knee", "Calf", "Foot"
					};
					for _, loc in ipairs(locations) do
						local node = DB.createChild(nodeList);
						DB.setValue(node, "location", "string", loc);
						DB.setValue(node, "av_b", "string", "0");
						DB.setValue(node, "av_e", "string", "0");
						DB.setValue(node, "av_p", "string", "0");
						DB.setValue(node, "av_f", "string", "0");
						DB.setValue(node, "is_rigid", "number", 0);
					end
				end

				-- Initial Area Attack Calculation
				if ArmorManager and ArmorManager.calculateAreaAttack then
					ArmorManager.calculateAreaAttack(nodeChar);
				end
			end

