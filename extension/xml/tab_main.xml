<?xml version="1.0" encoding="iso-8859-1"?>
<root>
	<!--
		HarnMaster Main Tab
		Birth, Family, Standing, Appearance, Traits, Fate
	-->

	<windowclass name="harn_tab_main">
		<sheetdata>
			<!-- Standard anchors to satisfy internal template logic (CoreRPG requirements) -->
			<genericcontrol name="leftanchor">
				<anchored position="insidetopleft" offset="0,0" width="0" height="0" />
			</genericcontrol>
			<genericcontrol name="rightanchor">
				<anchored position="insidetopright" offset="0,0" width="0" height="0" />
			</genericcontrol>

			<!-- PHYSICAL GROUP BOX -->
			<genericcontrol name="physical_group_box">
				<anchored position="insidetopleft" offset="50,5" width="135" height="185" />
				<frame name="groupbox" />
			</genericcontrol>
			<label name="physical_label">
				<anchored to="physical_group_box" position="insidetop" offset="0,10" width="100" height="20" />
				<static>PHYSICAL</static>
				<font>harn_group</font>
				<center />
			</label>

			<!-- STR Box -->
			<genericcontrol name="str_frame">
				<anchored position="insidetopleft" offset="60,35" width="45" height="56" />
				<icon>str_icon</icon>
				<tooltip text="Strength" />
			</genericcontrol>

			<numberfield name="str_score">
				<anchored to="str_frame" position="insidetopleft" offset="2,24" width="20" height="20" />
				<font>sheetnumber</font>
				<hideonzero />
			</numberfield>

			<numberfield name="str_ml">
				<anchored to="str_frame" position="insidetopright" offset="1,24" width="20" height="20" />
				<font>sheetnumber</font>
				<readonly />
				<hideonzero />
				<nodrag />
				</numberfield>

			<!-- END Box -->
			<genericcontrol name="end_frame">
				<anchored position="insidetopleft" offset="130,35" width="45" height="56" />
				<icon>end_icon</icon>
