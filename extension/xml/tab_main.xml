			</stringfield>
			<label name="inches_label">
				<anchored to="weight_label" position="right" offset="50,0" width="45" height="20" />
				<static>pounds</static>
				<font>sheettext</font>
			</label>

			<!-- Handedness -->
			<label name="handedness_label">
				<anchored to="weight_label" position="belowleft" offset="0,5" width="100" height="20" />
