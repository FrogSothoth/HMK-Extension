<?xml version="1.0" encoding="iso-8859-1"?>
<root>
	<!--
		HarnMaster Main Tab
		Birth, Family, Standing, Appearance, Traits, Fate
	-->

	<windowclass name="harn_tab_main">
		<sheetdata>
			<!-- Standard anchors to satisfy internal template logic (CoreRPG requirements) -->
			<genericcontrol name="leftanchor">
				<anchored position="insidetopleft" offset="0,0" width="0" height="0" />
			</genericcontrol>
			<genericcontrol name="rightanchor">
				<anchored position="insidetopright" offset="0,0" width="0" height="0" />
			</genericcontrol>

			<!-- Status Icon Row (Fixed Positioning) -->
			<!-- FAT and MOV are fixed at the margins -->
			<genericcontrol name="fat_frame">
				<anchored position="insidetopleft" offset="60,0" width="45" height="56" />
				<icon>fat_icon</icon>
				<tooltip text="Fate" />
			</genericcontrol>

			<genericcontrol name="grc_frame">
				<anchored to="fat_frame" position="right" offset="100,0" width="45" height="56" />
				<icon>grc_icon</icon>
				<tooltip text="Grace" />
			</genericcontrol>

			<genericcontrol name="mov_frame">
				<anchored position="insidetopright" offset="60,0" width="45" height="56" />
				<icon>mov_icon</icon>
				<tooltip text="Movement" />
			</genericcontrol>

			<genericcontrol name="pie_frame">
				<anchored to="mov_frame" position="left" offset="100,0" width="45" height="56" />
				<icon>pie_icon</icon>
				<tooltip text="Piety" />
			</genericcontrol>

			<!-- Character Portrait Area -->
			<!-- Manually centered at offset 220 from the left anchor to prevent stretching -->
			<genericcontrol name="portrait_background">
				<anchored height="245" width="175">
					<top offset="50" />
					<left parent="leftanchor" offset="220" />
				</anchored>
				<icon>portrait_bg</icon>
			</genericcontrol>

			<!-- Portrait control (centered at offset 237 from left, 67 from top) -->
			<!-- Using portraitcontrol which is the native CoreRPG control for PCs -->
			<portraitcontrol name="portrait">
				<anchored height="210" width="140">
					<top offset="67" />
					<left parent="leftanchor" offset="237" />
				</anchored>
				<tooltip text="Click to select Character Portrait" />
			</portraitcontrol>
		</sheetdata>
	</windowclass>
</root>
