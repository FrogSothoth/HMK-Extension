		HarnMaster Main Tab
		Birth, Family, Standing, Appearance, Traits, Fate
	-->

	<windowclass name="harn_tab_main">
		<script>
			function onInit()
				-- Update sunsign on load if we have values
				updateSunsign();

				-- Update birthplace realms on load if we have a nation
				local sNation = birthplace.getValue();
				if sNation and sNation ~= "" then
					updateBirthplaceRealms(sNation, true);
				end

				-- Update class options on load if we have a society
				local sSociety = society.getValue();
				updateClassOptions(sSociety, true);
			end

			function updateClassOptions(sSociety, bLoading)
				local sCurrentClass = class.getValue();
				
				if not bLoading then
					class.clear();
				end

				local tOptions = {};
				if sSociety == "Tribal" then
					tOptions = {"Unfree", "Free", "Priestly", "Noble"};
				elseif sSociety == "Tribal-Settled" then
					tOptions = {"Unfree", "Free", "Guilded", "Priestly", "Noble"};
				elseif sSociety == "Kuzhan" then
					tOptions = {"Larkuz (Tunnellers)", "Tolkuz (Builders)", "Azkuz (Makers)", "Erkuz (Providers)", "Zerkuz (Wanderers)", "Konkuz (Defenders)", "Yankuz (Rulers)"};
				elseif sSociety == "Sinain" then
					tOptions = {"Free", "Crafter", "Military", "Valpalen"};
				else
					tOptions = {"Unfree", "Free", "Guilded", "Military", "Priestly", "Noble"};
				end

				class.addItems(tOptions);

				if bLoading and sCurrentClass ~= "" then
					class.setValue(sCurrentClass);
				end
			end

			function updateBirthplaceRealms(sNation, bLoading)
				local sCurrentRealm = birthplace_realm.getValue();
				
				if not bLoading then
					birthplace_realm.clear();
				end

				if BirthData.Nations[sNation] then
					local tRealms = {};
					for sRealm, _ in pairs(BirthData.Nations[sNation]) do
						table.insert(tRealms, sRealm);
					end
					table.sort(tRealms);
					birthplace_realm.addItems(tRealms);
					birthplace_realm.setReadOnly(false);

					-- If loading, restore the current realm value
					if bLoading and sCurrentRealm ~= "" then
						birthplace_realm.setValue(sCurrentRealm);
					end
				else
					birthplace_realm.setReadOnly(true);
				end
			end

			function updateSunsign()
				local nDay = birthdate_day.getValue();
				local sMonth = birthdate_month.getValue();

				if nDay and nDay > 0 and sMonth and sMonth ~= "" then
					local sSunsign = HarnManager.getSunsign(sMonth, nDay);
					birth_sunsign.setValue(sSunsign);
				end
			end

			function onRefresh()
				-- Main tab refresh logic if needed
				updateSunsign();
			end
		</script>
