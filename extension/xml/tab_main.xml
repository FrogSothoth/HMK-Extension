				<readonly />
				<hideonzero />
				<nodrag />
				</numberfield>

			<!-- FAT GRC PIE MOV boxes -->
			<!-- FAT and MOV are fixed at the margins -->
			<genericcontrol name="fat_frame">
				<anchored position="insidetopleft" offset="60,190" width="45" height="56" />
				<icon>fat_icon</icon>
				<tooltip text="Fate" />
			</genericcontrol>

			<!-- Fate Values Overlay -->
			<numberfield name="fate_roll">
				<anchored to="fat_frame" position="insidetopleft" offset="2,22" width="20" height="20" />
				<font>sheetnumber</font>
				<readonly />
				<hideonzero />
				<nodrag />
			</numberfield>

			<numberfield name="fate_fp">
				<anchored to="fat_frame" position="insidetopright" offset="1,22" width="20" height="20" />
				<font>sheetnumber</font>
				<hideonzero />
			</numberfield>


			<!-- GRC Box -->
			<genericcontrol name="grc_frame">
				<anchored to="fat_frame" position="right" offset="25,0" width="45" height="56" />
				<icon>grc_icon</icon>
				<tooltip text="Grace" />
			</genericcontrol>

			<!-- Grace Values Overlay -->
			<numberfield name="grace_total">
				<anchored to="grc_frame" position="insidetopleft" offset="2,22" width="20" height="20" />
				<font>sheetnumber</font>
				<hideonzero />
				<nodrag />
			</numberfield>

			<numberfield name="grace_left">
