			<stringfield name="eyes">
				<anchored to="eyes_label" position="right" offset="5,0" width="85" height="20" />
				<font>sheettext</font>
				<frame name="fielddark" offset="7,5,7,5" />
			</stringfield>

			<!-- Height -->
			<label name="height_label">
				<anchored to="eyes_label" position="belowleft" offset="0,5" width="100" height="20" />
				<static>HEIGHT:</static>
				<font>harn_label_18_bold</font>
			</label>
			<stringfield name="height">
				<anchored to="height_label" position="right" offset="5,0" width="25" height="20" />
				<font>sheettext</font>
				<frame name="fielddark" offset="7,5,7,5" />
			</stringfield>
			<label name="inches_label">
				<anchored to="height_label" position="right" offset="50,0" width="35" height="20" />
				<static>inches</static>
				<font>sheettext</font>
			</label>

			<!-- Weight -->
			<label name="weight_label">
				<anchored to="height_label" position="belowleft" offset="0,5" width="100" height="20" />
				<static>WEIGHT:</static>
				<font>harn_label_18_bold</font>
