				<font>sheetnumber</font>
				<hideonzero />
			</numberfield>

			<genericcontrol name="mov_frame">
				<anchored position="insidetopright" offset="60,190" width="45" height="56" />
				<icon>mov_icon</icon>
				<tooltip text="Movement" />
			</genericcontrol>

			<!-- Movement Values Overlay -->
			<numberfield name="move">
				<anchored to="mov_frame" position="insidetopleft" offset="2,22" width="20" height="20" />
				<font>sheetnumber</font>
				<readonly />
				<hideonzero />
				<nodrag />
			</numberfield>

			<numberfield name="move_effective">
				<anchored to="mov_frame" position="insidetopright" offset="1,22" width="20" height="20" />
				<font>sheetnumber</font>
				<readonly />
				<hideonzero />
				<nodrag />
			</numberfield>

			<genericcontrol name="pie_frame">
				<anchored to="mov_frame" position="left" offset="25,0" width="45" height="56" />
				<icon>pie_icon</icon>
				<tooltip text="Piety" />
			</genericcontrol>

			<!-- Piety Values Overlay -->
			<numberfield name="piety_max">
				<anchored to="pie_frame" position="insidetopleft" offset="2,22" width="20" height="20" />
				<font>sheetnumber</font>
				<hideonzero />
				<nodrag />
			</numberfield>

			<numberfield name="piety_left">
				<anchored to="pie_frame" position="insidetopright" offset="1,22" width="20" height="20" />
				<font>sheetnumber</font>
				<hideonzero />
			</numberfield>

			<!-- Character Portrait Area (dynamically centered)-->
			<genericcontrol name="portrait_background">
				<anchored height="245" width="175">
					<top offset="0" />
					<left anchor="center" offset="-87" />
				</anchored>
				<icon>portrait_bg</icon>
			</genericcontrol>

			<!-- Portrait (tokenfield with drawmode=fit renders raw asset at full size) -->
			<tokenfield name="portrait">
				<anchored height="210" width="140">
					<top offset="17" />
					<left anchor="center" offset="-70" />
				</anchored>
				<drawmode>fit</drawmode>
				<script file="scripts/portrait_charsheet.lua" />
			</tokenfield>

			<!-- Appearance Box -->
			<genericcontrol name="appearance_box">
				<anchored width="225" height="215">
					<top offset="270" />
					<left parent="leftanchor" offset="60" />
				</anchored>
				<frame name="groupbox" />
			</genericcontrol>
			<label name="appearance_label">
				<anchored to="appearance_box" position="insidetop" offset="10,10" width="100" height="20" />
				<static>APPEARANCE</static>
				<font>harn_group</font>
				<center />
			</label>

			<!-- Complexion -->
			<label name="complexion_label">
				<anchored to="appearance_box" position="insidetopleft" offset="20,40" width="100" height="20" />
				<static>COMPLEXION:</static>
				<font>harn_label_18_bold</font>
			</label>
			<stringfield name="complexion">
				<anchored to="complexion_label" position="right" offset="5,0" width="85" height="20" />
				<font>sheettext</font>
				<frame name="fielddark" offset="7,5,7,5" />
			</stringfield>

			<!-- Hair -->
			<label name="hair_label">
				<anchored to="complexion_label" position="belowleft" offset="0,5" width="100" height="20" />
				<static>HAIR:</static>
				<font>harn_label_18_bold</font>
			</label>
			<stringfield name="hair">
				<anchored to="hair_label" position="right" offset="5,0" width="85" height="20" />
				<font>sheettext</font>
				<frame name="fielddark" offset="7,5,7,5" />
			</stringfield>

			<!-- Eyes -->
