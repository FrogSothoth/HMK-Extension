			<!-- ELO Box -->
			<genericcontrol name="elo_frame">
				<anchored position="insidetopright" offset="60,125" width="45" height="56" />
				<icon>elo_icon</icon>
				<tooltip text="Eloquence" />
			</genericcontrol>

			<numberfield name="elo_score">
				<anchored to="elo_frame" position="insidetopleft" offset="2,24" width="20" height="20" />
