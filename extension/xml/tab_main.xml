				</numberfield>

			<!-- CRE Box -->
			<genericcontrol name="cre_frame">
				<anchored position="insidetopright" offset="60,80" width="45" height="56" />
				<icon>cre_icon</icon>
				<tooltip text="Creativity" />
			</genericcontrol>

			<numberfield name="cre_score">
				<anchored to="cre_frame" position="insidetopleft" offset="2,24" width="20" height="20" />
				<font>sheetnumber</font>
				<hideonzero />
			</numberfield>

			<numberfield name="cre_ml">
				<anchored to="cre_frame" position="insidetopright" offset="1,24" width="20" height="20" />
				<font>sheetnumber</font>
				<readonly />
				<hideonzero />
				<nodrag />
				</numberfield>

			<!-- EMP Box -->
			<genericcontrol name="emp_frame">
				<anchored position="insidetopright" offset="130,125" width="45" height="56" />
				<icon>emp_icon</icon>
				<tooltip text="Empathy" />
			</genericcontrol>

			<numberfield name="emp_score">
				<anchored to="emp_frame" position="insidetopleft" offset="2,24" width="20" height="20" />
