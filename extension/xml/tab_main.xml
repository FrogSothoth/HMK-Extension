			</stringfield>

			<!-- Notes Box -->
			<genericcontrol name="notes_box">
				<anchored width="225" height="265">
					<top offset="270" />
					<right parent="rightanchor" offset="-60" />
				</anchored>
				<frame name="groupbox" />
			</genericcontrol>
			<label name="notesgroup_label">
				<anchored to="notes_box" position="insidetop" offset="10,10" width="100" height="20" />
				<static>NOTES</static>
				<font>harn_group</font>
				<center />
			</label>

			<!-- Morality -->
			<label name="morality_label">
				<anchored to="notes_box" position="insidetopleft" offset="20,40" width="75" height="20" />
				<static>MORALITY:</static>
				<font>harn_label_18_bold</font>
			</label>
			<stringfield name="mor_score">
				<anchored to="morality_label" position="right" offset="5,0" width="20" height="20" />
				<font>sheettext</font>
				<frame name="fielddark" offset="7,5,7,5" />
				<script>
					function onInit()
						onValueChanged()
					end
					function onValueChanged()
						local nScore = getValue()
						local sDescriptor = HarnManager.getMoralityDescriptor(nScore)
						window.mor_descriptor.setValue(sDescriptor)
					end
				</script>
			</stringfield>

			<stringcontrol name="mor_descriptor">
				<anchored to="mor_score" position="right" offset="10,0" width="100" height="20" />
				<font>sheettext</font>
				<readonly />
			</stringcontrol>

			<!-- Wealth -->
			<label name="wealth_label">
				<anchored to="morality_label" position="belowleft" offset="0,5" width="75" height="20" />
