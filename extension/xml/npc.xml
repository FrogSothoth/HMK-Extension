<?xml version="1.0" encoding="iso-8859-1"?>
<root>
	<!--
		HarnMaster NPC Sheet Definition
		Completely redefines the npc windowclass to use HarnMaster tabs
	-->

	<!-- NPC Skill Entry - simplified version without SM or special fields -->
	<windowclass name="harn_npc_skill_entry">
		<margins control="0,0,0,2" />
		<script>
			function onInit()
				-- Set up handler to recalculate SB when attributes change
				local node = getDatabaseNode();
				if node then
					DB.addHandler(node.getPath() .. ".att1", "onUpdate", recalculateSB);
					DB.addHandler(node.getPath() .. ".att2", "onUpdate", recalculateSB);
				end
			end

			function onClose()
				local node = getDatabaseNode();
				if node then
					DB.removeHandler(node.getPath() .. ".att1", "onUpdate", recalculateSB);
					DB.removeHandler(node.getPath() .. ".att2", "onUpdate", recalculateSB);
				end
			end

			function recalculateSB()
				local node = getDatabaseNode();
				if not node then return; end

				local sAtt1 = DB.getValue(node, "att1", "");
				local sAtt2 = DB.getValue(node, "att2", "");
				if sAtt1 == "" or sAtt2 == "" then return; end

				-- Navigate to NPC node (skill -> skills -> npc)
				local nodeNPC = node.getParent().getParent();
				if not nodeNPC then return; end

				-- Use SkillsManager if available
				if SkillsManager and SkillsManager.calculateSB then
					local nSB = SkillsManager.calculateSB(nodeNPC, sAtt1, sAtt2);
					DB.setValue(node, "sb", "number", nSB);
				end
			end
		</script>
		<sheetdata>
			<!-- Skill Name (100px to match charsheet) -->
			<stringfield name="name">
				<anchored position="insidetopleft" offset="5,0" width="100" height="20" />
				<frame name="fielddark" offset="7,5,7,5" />
				<script>
					function onLoseFocus()
						local sName = getValue();
						if sName == "" then return; end

						Debug.console("NPC Skill name entered: " .. sName);

						-- Look up skill data from database
						local nodeSkillsRef = DB.findNode("harnmaster.skills");
						if nodeSkillsRef then
							for _, nodeRefSkill in pairs(DB.getChildren(nodeSkillsRef)) do
								if DB.getValue(nodeRefSkill, "name", "") == sName then
									local sAtt1 = DB.getValue(nodeRefSkill, "att1", "");
									local sAtt2 = DB.getValue(nodeRefSkill, "att2", "");

									Debug.console("Found skill: att1=" .. sAtt1 .. ", att2=" .. sAtt2);

									-- Update att1, att2 fields in NPC's skill entry
									local nodeSkill = window.getDatabaseNode();
									if nodeSkill then
										DB.setValue(nodeSkill, "att1", "string", sAtt1);
										DB.setValue(nodeSkill, "att2", "string", sAtt2);

										-- Navigate to NPC node and calculate SB directly
										local nodeNPC = nodeSkill.getParent().getParent();
										Debug.console("nodeSkill path: " .. DB.getPath(nodeSkill));
										Debug.console("nodeNPC path: " .. DB.getPath(nodeNPC));

										-- Get attribute values directly
										local sAtt1Field = string.lower(sAtt1) .. "_score";
										local sAtt2Field = string.lower(sAtt2) .. "_score";
										local nAtt1 = DB.getValue(nodeNPC, sAtt1Field, 0);
										local nAtt2 = DB.getValue(nodeNPC, sAtt2Field, 0);

										Debug.console(sAtt1 .. " (" .. sAtt1Field .. ") = " .. tostring(nAtt1));
										Debug.console(sAtt2 .. " (" .. sAtt2Field .. ") = " .. tostring(nAtt2));

										-- Calculate SB: average, round up if att1 > att2, else round down
										local nSB = 0;
										if nAtt1 > 0 or nAtt2 > 0 then
											local nSum = nAtt1 + nAtt2;
											if nAtt1 > nAtt2 then
												nSB = math.ceil(nSum / 2);
											else
												nSB = math.floor(nSum / 2);
											end
										end

										Debug.console("Calculated SB: " .. tostring(nSB));
										DB.setValue(nodeSkill, "sb", "number", nSB);
									end
									return;
								end
							end
							Debug.console("NPC Skill not found in harnmaster.skills: " .. sName);
						else
							Debug.console("ERROR: harnmaster.skills node not found");
						end
					end
				</script>
			</stringfield>

			<!-- ATT1 (readonly) -->
			<stringfield name="att1">
				<anchored position="insidetopleft" offset="110,0" width="35" height="20" />
				<frame name="fielddark" offset="7,5,7,5" />
				<font>sheettext</font>
