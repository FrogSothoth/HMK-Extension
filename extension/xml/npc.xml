			</numberfield>

			<!-- EMP -->
			<label name="emp_label">
				<anchored to="cre_label" position="below" offset="0,5" width="70" height="20" />
				<static textres="harn_attr_emp" />
			</label>
			<label name="emp_abbr">
				<anchored to="emp_label" position="righthigh" offset="5,0" width="35" height="20" />
				<static textres="harn_attr_emp_abbr" />
				<font>sheetlabel</font>
			</label>
			<numberfield name="emp_score">
				<anchored to="emp_abbr" position="righthigh" offset="5,0" width="40" height="20" />
				<frame name="fielddark" offset="7,5,7,5" />
				<source>emp_score</source>
				<script>
					function onValueChanged()
						local nScore = getValue() or 0;
						window.emp_ml.setValue(nScore * 5);
						window.recalculateNPCSkills();
					end
				</script>
			</numberfield>
			<numberfield name="emp_ml">
				<anchored to="emp_score" position="righthigh" offset="5,0" width="35" height="20" />
				<frame name="fielddark" offset="7,5,7,5" />
				<readonly />
			</numberfield>

			<!-- ELO -->
			<label name="elo_label">
				<anchored to="emp_label" position="below" offset="0,5" width="70" height="20" />
				<static textres="harn_attr_elo" />
			</label>
			<label name="elo_abbr">
				<anchored to="elo_label" position="righthigh" offset="5,0" width="35" height="20" />
				<static textres="harn_attr_elo_abbr" />
				<font>sheetlabel</font>
			</label>
			<numberfield name="elo_score">
				<anchored to="elo_abbr" position="righthigh" offset="5,0" width="40" height="20" />
				<frame name="fielddark" offset="7,5,7,5" />
				<source>elo_score</source>
				<script>
					function onValueChanged()
						local nScore = getValue() or 0;
						window.elo_ml.setValue(nScore * 5);
						window.recalculateNPCSkills();
					end
				</script>
			</numberfield>
			<numberfield name="elo_ml">
				<anchored to="elo_score" position="righthigh" offset="5,0" width="35" height="20" />
				<frame name="fielddark" offset="7,5,7,5" />
				<readonly />
			</numberfield>

			<!-- Morality - aligned with mental attributes above -->
			<label name="morality_label">
				<anchored to="elo_label" position="below" offset="0,20" width="70" height="20" />
				<static textres="harn_morality" />
			</label>
			<numberfield name="morality">
				<anchored to="elo_score" position="below" offset="0,20" width="40" height="20" />
				<frame name="fielddark" offset="7,5,7,5" />
				<min>0</min>
				<script>
					function onValueChanged()
						if window.morality_display then
							window.morality_display.updateDisplay();
						end
					end
				</script>
			</numberfield>
			<stringfield name="morality_display">
				<anchored to="morality" position="righthigh" offset="2,0" width="75" height="20" />
				<frame name="fielddark" offset="7,5,7,5" />
				<readonly />
				<script>
					function onInit()
						updateDisplay();
					end
					function updateDisplay()
						local nMorality = 0;
						if window.morality then
							nMorality = window.morality.getValue() or 0;
						end
						local sText = "";
						if nMorality >= 17 then
							sText = "Exemplary";
						elseif nMorality >= 14 then
							sText = "Principled";
						elseif nMorality >= 11 then
							sText = "Dutiful";
						elseif nMorality >= 8 then
							sText = "Corruptible";
						elseif nMorality >= 5 then
							sText = "Unscrupulous";
						elseif nMorality >= 1 then
							sText = "Diabolical";
						end
						setValue(sText);
					end
				</script>
			</stringfield>

			<!-- SKILLS Section -->
			<label name="skills_title">
				<anchored to="abe_label" position="below" offset="0,25" width="490" height="20" />
				<static textres="harn_skills" />
				<font>sheetlabel</font>
				<center />
				<frame name="headersimple" offset="10,3,10,3" />
			</label>

			<!-- Skills column headers -->
			<label name="skills_h_skill">
				<anchored to="skills_title" position="below" offset="5,5" width="100" height="15" />
				<static>Skill</static>
				<font>sheetlabel</font>
			</label>
			<label name="skills_h_att1">
				<anchored to="skills_h_skill" position="righthigh" offset="25,0" width="35" height="15" />
				<static>ATT1</static>
				<font>sheetlabel</font>
				<center />
			</label>
			<label name="skills_h_att2">
				<anchored to="skills_h_att1" position="righthigh" offset="5,0" width="35" height="15" />
				<static>ATT2</static>
				<font>sheetlabel</font>
				<center />
			</label>
			<label name="skills_h_sb">
				<anchored to="skills_h_att2" position="righthigh" offset="5,0" width="30" height="15" />
				<static>SB</static>
				<font>sheetlabel</font>
				<center />
			</label>
			<label name="skills_h_ml">
				<anchored to="skills_h_sb" position="righthigh" offset="5,0" width="35" height="15" />
				<static>ML</static>
				<font>sheetlabel</font>
				<center />
			</label>

			<!-- Skills windowlist -->
			<windowlist name="skills">
				<anchored to="skills_h_skill" position="below" offset="0,2">
					<left parent="" offset="5" />
					<right parent="" offset="-5" />
				</anchored>
				<datasource>.skills</datasource>
				<class>harn_npc_skill_entry</class>
				<sortby><field>name</field></sortby>
				<noscroll />
				<allowcreate />
				<allowdelete />
			</windowlist>

			<button_iadd name="skills_iadd">
				<anchored to="skills" position="aboveright" offset="5,8" />
				<target>skills</target>
			</button_iadd>
		</sheetdata>
	</windowclass>

	<windowclass name="harn_npc_tab_combat">
		<margins control="0,0,0,5" />
		<sheetdata>
			<!-- Placeholder for future Combat tab content -->
		</sheetdata>
	</windowclass>

	<windowclass name="harn_npc_tab_gear">
		<margins control="0,0,0,5" />
		<sheetdata>
			<!-- Placeholder for future Gear tab content -->
		</sheetdata>
	</windowclass>
</root>
